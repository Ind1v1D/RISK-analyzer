# Copy to backend/.env and fill in. Never commit the real .env.
#
# PRIVACY: the FREE Gemini API tier lets Google use submitted content to improve
# its products. Use a PAID key (billing enabled) before analysing real client
# documents.

# Required. Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-key-here

# Model used for analysis (a stable fallback is discovered automatically).
GEMINI_MODEL=gemini-3.6-flash
# Fixed sampling seed so the same contract gives the same result.
GEMINI_SEED=42

# Per-client rate limit on /api/analyze (in-memory, per server process).
# Counting policy: file uploads count BEFORE parsing (parsing is expensive);
# pasted text counts only after it passed validation. Requests with no input
# or an oversized body (rejected before reaching the endpoint) are free.
RATE_LIMIT_PER_MINUTE=5
RATE_LIMIT_PER_DAY=50
# Max distinct clients remembered by the limiter (least recently seen dropped).
MAX_TRACKED_CLIENTS=10000

# Max Gemini analyses running at once; extra requests wait up to
# QUEUE_TIMEOUT_SECONDS and then get HTTP 503.
MAX_CONCURRENT_ANALYSES=2
QUEUE_TIMEOUT_SECONDS=30

# Time budget for Gemini. The frontend gives up after 150 s, so
# QUEUE_TIMEOUT_SECONDS + ANALYSIS_DEADLINE_SECONDS must stay below that.
GEMINI_TIMEOUT_SECONDS=60       # one HTTP call to Gemini
ANALYSIS_DEADLINE_SECONDS=110   # all attempts + fallback model together

# Set to 1 only behind a trusted reverse proxy (Render, nginx). The client IP is
# then taken from X-Forwarded-For counting TRUSTED_PROXY_HOPS entries from the
# END (each proxy appends the peer it saw; the start of the header is client
# controlled and spoofable). 1 = a single proxy such as Render.
TRUST_PROXY=0
TRUSTED_PROXY_HOPS=1

# Comma-separated browser origins allowed by CORS (dev server by default).
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Port used by the Docker image / hosting platform.
PORT=8000
